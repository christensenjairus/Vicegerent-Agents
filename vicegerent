#!/usr/bin/env bash
set -euo pipefail

git_common_dir() {
  local root="$1" common_dir
  common_dir="$(git -C "$root" rev-parse --git-common-dir)" || return
  if [[ "$common_dir" != /* ]]; then
    common_dir="$root/$common_dir"
  fi
  cd -P "$common_dir" >/dev/null 2>&1 && pwd
}

# Resolve the installed CLI target first. When invoked from a sibling worktree of
# that checkout, run the command and its helpers from the caller's worktree.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  src_dir="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$src_dir/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
CALLER_ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$CALLER_ROOT" ]] \
  && [[ "$(git_common_dir "$CALLER_ROOT")" == "$(git_common_dir "$REPO_ROOT")" ]]; then
  REPO_ROOT="$CALLER_ROOT"
fi
cd "$REPO_ROOT"

# shellcheck source=scripts/lib/cli-ui.sh
source "$REPO_ROOT/scripts/lib/cli-ui.sh"
C="$UI_CYAN"

# Resolve KUBE_CONTEXT (scripts/lib/kube-context.sh): default kind-vicegerent or a
# VICEGERENT_KUBE_CONTEXT-selected local Kind context. It is always guarded so a bare kubectl call can't
# silently hit whatever cluster the ambient kubeconfig points at.
# shellcheck source=scripts/lib/kube-context.sh
source "$REPO_ROOT/scripts/lib/kube-context.sh"
# shellcheck source=scripts/lib/kind-userns.sh
source "$REPO_ROOT/scripts/lib/kind-userns.sh"
# Drive the host-side ToolHive/vMCP stack controller (host/mcp/vicegerent_mcp.py)
# from the environment created by `vicegerent setup mcp`. Runtime commands do not
# reconcile packages, so `stop` remains available when a package source is down.
mcp_py() {
  if [[ ! -x "$REPO_ROOT/.venv/bin/python" ]]; then
    ui_error "Repository Python environment not found. Run: ./vicegerent setup mcp"
    return 127
  fi
  "$REPO_ROOT/.venv/bin/python" "$REPO_ROOT/host/mcp/vicegerent_mcp.py" "$@"
}

restore_terminal() {
  [[ -t 1 ]] || return 0
  printf '\033[<u\033[?2004l\033[?1000l\033[?1002l\033[?1003l\033[?1004l\033[?1006l\033[?2026l\033[?1049l\033[?1l\033>'
}

# These run inside the agent container. `vicegerent ssh` sends these functions
# through `bash -c` so the workflow does not depend on a script existing inside
# whichever repository or worktree the user selects.
agent_fzf_input() {
  local prompt="$1" initial="${2:-}" header="${3:-Enter: accept | Esc: back | Ctrl-C: quit}"
  local result shortcut

  result="$(
    printf 'input\t\n' | fzf --ansi --phony --print-query --query="$initial" --border \
      --height=100% --layout=reverse --delimiter=$'\t' --with-nth=2.. --pointer='' \
      --expect=esc --prompt="$prompt" --header=" $header"
  )" || return
  AGENT_FZF_VALUE="${result%%$'\n'*}"
  result="${result#*$'\n'}"
  shortcut="${result%%$'\n'*}"
  [[ "$shortcut" == esc ]] && return 2
  return 0
}

agent_choose_directory() {
  local workspace_root="${VICEGERENT_WORKSPACE_ROOT:-/workspace}"
  local preferred_repo="${1:-}" base_ref candidate top choice shortcut index line primary destination remote repo repo_name status worktree_listing worktree_name git_error
  local prune_index prune_path prune_branch prune_note confirm force_confirm pane_cwd in_use
  local -a repos=() paths=() branches=() worktree_names=()

  AGENT_SESSION_NOTICE=""

  for candidate in "$workspace_root"/*; do
    [[ -d "$candidate" ]] || continue
    top="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -n "$top" && "$(cd "$candidate" && pwd -P)" == "$(cd "$top" && pwd -P)" ]] || continue
    repos+=("$candidate")
  done

  while true; do
    if [[ -n "$preferred_repo" ]]; then
      repo="$preferred_repo"
      preferred_repo=""
    else
      choice="$(
        {
          printf 'workspace\t%s/workspace%s\t%sno repository or worktree | Ctrl-W%s\n' \
            "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
          for index in "${!repos[@]}"; do
            printf 'repo:%d\t%s%s%s\t%s%s%s\n' \
              "$index" "$UI_GREEN" "$(basename "${repos[index]}")" "$UI_RESET" \
              "$UI_DIM" "${repos[index]}" "$UI_RESET"
          done
        } | fzf --ansi --layout=reverse --border --height=100% --bind='start:pos(2)' \
          --delimiter=$'\t' --with-nth=2.. --expect=esc,ctrl-w --prompt='Repository> ' \
          --header='Enter: select | Ctrl-W: /workspace | Esc: back | Ctrl-C: quit'
      )" || return
      shortcut="${choice%%$'\n'*}"
      choice="${choice#*$'\n'}"
      case "$shortcut" in
        esc) return 2 ;;
        ctrl-w) choice=workspace ;;
      esac
      choice="${choice%%$'\t'*}"
      if [[ "$choice" == workspace ]]; then
        AGENT_SESSION_CWD="$workspace_root"
        AGENT_SESSION_DEFAULT=main
        AGENT_SESSION_REPO=""
        return
      fi
      if [[ "$choice" != repo:* ]]; then
        printf '%sInvalid repository selection.%s\n' "$UI_RED" "$UI_RESET" >&2
        return 1
      fi
      index="${choice#repo:}"
      repo="${repos[index]}"
    fi

    while true; do
      paths=()
      branches=()
      worktree_listing="$(git -C "$repo" worktree list --porcelain)" || return 1
      paths=()
      branches=()
      while IFS= read -r line; do
        case "$line" in
          'worktree '*)
            paths+=("${line#worktree }")
            branches+=(detached)
            ;;
          'branch refs/heads/'*)
            branches[${#branches[@]} - 1]="${line#branch refs/heads/}"
            ;;
        esac
      done <<< "$worktree_listing"
      primary="${paths[0]}"
      repo_name="$(basename "$primary")"
      worktree_names=()
      for index in "${!paths[@]}"; do
        if [[ "${paths[index]}" == "$primary" ]]; then
          worktree_names+=(main)
        elif [[ "${paths[index]}" == "$primary/.worktrees/"* ]]; then
          worktree_names+=("${paths[index]#"$primary/.worktrees/"}")
        else
          worktree_names+=("$(basename "${paths[index]}")")
        fi
      done

      choice="$(
        {
          printf 'new\t%screate a new worktree%s\t%sCtrl-N%s\n' \
            "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
          printf 'prune\t%sprune a linked worktree%s\t%sbranch kept | Ctrl-P%s\n' \
            "$UI_YELLOW" "$UI_RESET" "$UI_DIM" "$UI_RESET"
          printf 'workspace\t%s/workspace%s\t%sno repository or worktree | Ctrl-W%s\n' \
            "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
          for index in "${!paths[@]}"; do
            printf 'worktree:%d\t%s%s%s\t%s%s%s\n' \
              "$index" "$UI_GREEN" "${worktree_names[index]}" "$UI_RESET" \
              "$UI_DIM" "${paths[index]}" "$UI_RESET"
          done
        } | fzf --ansi --layout=reverse --border --height=100% --bind='start:pos(4)' \
          --delimiter=$'\t' --with-nth=2.. --expect=esc,ctrl-n,ctrl-p,ctrl-w --prompt='Worktree> ' \
          --header='Enter: select | Ctrl-N: new | Ctrl-P: prune | Ctrl-W: /workspace | Esc: back | Ctrl-C: quit'
      )" || return
      shortcut="${choice%%$'\n'*}"
      choice="${choice#*$'\n'}"
      case "$shortcut" in
        esc) break ;;
        ctrl-n) choice=new ;;
        ctrl-p) choice=prune ;;
        ctrl-w) choice=workspace ;;
      esac
      choice="${choice%%$'\t'*}"
      case "$choice" in
      workspace)
        AGENT_SESSION_CWD="$workspace_root"
        AGENT_SESSION_DEFAULT=main
        return
        ;;
      prune)
        choice="$(
          {
            for index in "${!paths[@]}"; do
              [[ "${paths[index]}" == "$primary" ]] && continue
              printf 'prune:%d\t%s%s%s\t%s%s%s\n' \
                "$index" "$UI_YELLOW" "${branches[index]}" "$UI_RESET" \
                "$UI_DIM" "${paths[index]}" "$UI_RESET"
            done
          } | fzf --ansi --layout=reverse --border --height=100% \
            --delimiter=$'\t' --with-nth=2.. --expect=esc --prompt='Prune worktree> ' \
            --header='Enter: choose worktree to prune | Esc: back | Ctrl-C: quit'
        )" || return
        shortcut="${choice%%$'\n'*}"
        choice="${choice#*$'\n'}"
        [[ "$shortcut" == esc ]] && continue
        choice="${choice%%$'\t'*}"
        [[ "$choice" == prune:* ]] || continue
        prune_index="${choice#prune:}"
        prune_path="${paths[prune_index]}"
        prune_branch="${branches[prune_index]}"
        if [[ "$prune_branch" == detached ]]; then
          prune_note='No branch will be deleted.'
        else
          prune_note='The branch will be kept.'
        fi
        in_use=false
        while IFS= read -r pane_cwd; do
          if [[ "$pane_cwd" == "$prune_path" || "$pane_cwd" == "$prune_path/"* ]]; then
            in_use=true
            break
          fi
        done < <(tmux -u list-panes -a -F '#{pane_current_path}' 2>/dev/null || true)
        if [[ "$in_use" == true ]]; then
          printf '%sA tmux pane is still using %s. Move or close it before pruning.%s\n' \
            "$UI_RED" "'$prune_path'" "$UI_RESET" >&2
          continue
        fi
        confirm="$(
          {
            printf 'cancel\t%scancel%s\t%skeep the worktree%s\n' \
              "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
            printf 'confirm\t%sprune worktree%s\t%sbranch kept%s\n' \
              "$UI_YELLOW" "$UI_RESET" "$UI_DIM" "$UI_RESET"
          } | fzf --ansi --layout=reverse --border --height=100% \
            --delimiter=$'\t' --with-nth=2.. --expect=esc --prompt='Confirm prune> ' \
            --header="Prune '$prune_branch' at '$prune_path' | $prune_note | Esc: back | Ctrl-C: quit"
        )" || return
        shortcut="${confirm%%$'\n'*}"
        confirm="${confirm#*$'\n'}"
        [[ "$shortcut" == esc ]] && continue
        confirm="${confirm%%$'\t'*}"
        if [[ "$confirm" != confirm ]]; then
          printf '%sPrune cancelled.%s\n' "$UI_DIM" "$UI_RESET"
          continue
        fi
        if ! git_error="$(git -C "$primary" worktree remove -- "$prune_path" 2>&1)"; then
          if [[ "$git_error" == *'contains modified or untracked files'* ]]; then
            force_confirm="$(
              {
                printf 'cancel\t%scancel%s\t%skeep all worktree files%s\n' \
                  "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
                printf 'force\t%sforce remove worktree%s\t%sdelete modified and untracked files%s\n' \
                  "$UI_RED" "$UI_RESET" "$UI_DIM" "$UI_RESET"
              } | fzf --ansi --layout=reverse --border --height=100% \
                --delimiter=$'\t' --with-nth=2.. --expect=esc --prompt='Confirm force prune> ' \
                --header="Force removal permanently deletes modified and untracked files at '$prune_path' | Esc: back | Ctrl-C: quit"
            )" || return
            shortcut="${force_confirm%%$'\n'*}"
            force_confirm="${force_confirm#*$'\n'}"
            [[ "$shortcut" == esc ]] && continue
            force_confirm="${force_confirm%%$'\t'*}"
            if [[ "$force_confirm" != force ]]; then
              printf '%sForce prune cancelled.%s\n' "$UI_DIM" "$UI_RESET"
              continue
            fi
            git -C "$primary" worktree remove --force -- "$prune_path" || return 1
          else
            printf '%s\n' "$git_error" >&2
            return 1
          fi
        fi
        if [[ "$prune_branch" == detached ]]; then
          printf '%sPruned worktree %s. No branch was deleted.%s\n' \
            "$UI_GREEN" "'$prune_path'" "$UI_RESET"
        else
          printf '%sPruned worktree %s. The branch %s was kept.%s\n' \
            "$UI_GREEN" "'$prune_path'" "'$prune_branch'" "$UI_RESET"
        fi
        ;;
      new)
        worktree_name=""
        while true; do
          if agent_fzf_input 'Worktree name: ' "$worktree_name" 'Enter: create worktree | Esc: back | Ctrl-C: quit'; then
            worktree_name="$AGENT_FZF_VALUE"
          else
            status=$?
            [[ "$status" -eq 2 ]] && continue 2
            return "$status"
          fi
          if [[ -z "$worktree_name" || "$worktree_name" == /* || "$worktree_name" == . || "$worktree_name" == .. \
            || "$worktree_name" == */./* || "$worktree_name" == ./* || "$worktree_name" == */. \
            || "$worktree_name" == */../* || "$worktree_name" == ../* || "$worktree_name" == */.. ]] \
            || ! git check-ref-format --branch "$worktree_name" >/dev/null 2>&1; then
            printf '%sInvalid worktree name: %s%s\n' "$UI_RED" "'$worktree_name'" "$UI_RESET" >&2
            return 1
          fi
          destination=""
          create_worktree=true
          for index in "${!worktree_names[@]}"; do
            if [[ "${worktree_names[index]}" == "$worktree_name" ]]; then
              destination="${paths[index]}"
              create_worktree=false
              break
            fi
          done
          [[ "$create_worktree" == false ]] && break
          destination="$primary/.worktrees/$worktree_name"
          if [[ -e "$destination" ]]; then
            printf '%sWorktree path already exists and is not a registered Git worktree: %s%s\n' \
              "$UI_RED" "'$destination'" "$UI_RESET" >&2
            return 1
          fi
          git -C "$primary" worktree prune || return 1
          for remote in upstream origin; do
            git -C "$primary" remote get-url "$remote" >/dev/null 2>&1 || continue
            if ! git_error="$(git -C "$primary" fetch --prune --no-tags "$remote" 2>&1)"; then
              printf '%sCannot refresh %s before creating the worktree: %s%s\n' \
                "$UI_RED" "'$remote'" "$git_error" "$UI_RESET" >&2
              return 1
            fi
          done
          base_ref=""
          for remote in upstream origin; do
            git -C "$primary" remote get-url "$remote" >/dev/null 2>&1 || continue
            git -C "$primary" remote set-head "$remote" --auto >/dev/null 2>&1 || continue
            candidate="$(git -C "$primary" symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
            if [[ "$candidate" == "$remote/"* ]] \
              && git -C "$primary" rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
              base_ref="$candidate"
              break
            fi
          done
          if [[ -z "$base_ref" ]]; then
            printf '%sNo freshly fetched upstream or origin default branch is available; refusing to create a stale worktree.%s\n' \
              "$UI_RED" "$UI_RESET" >&2
            return 1
          fi
          mkdir -p "$(dirname "$destination")" || return
          git -C "$primary" worktree add --quiet -b "$worktree_name" "$destination" "$base_ref" || return 1
          AGENT_SESSION_NOTICE="Branch '$worktree_name' is up to date with $base_ref."
          break
        done
        AGENT_SESSION_CWD="$destination"
        AGENT_SESSION_DEFAULT="$(printf '%s-%s' "$repo_name" "${worktree_name//\//-}" | tr -cs '[:alnum:]_-' '-')"
        AGENT_SESSION_DEFAULT="${AGENT_SESSION_DEFAULT%-}"
        AGENT_SESSION_REPO="$repo"
        return
        ;;
      worktree:*)
        index="${choice#worktree:}"
        AGENT_SESSION_CWD="${paths[index]}"
        AGENT_SESSION_DEFAULT="$(printf '%s-%s' "$repo_name" "${worktree_names[index]//\//-}" | tr -cs '[:alnum:]_-' '-')"
        AGENT_SESSION_DEFAULT="${AGENT_SESSION_DEFAULT%-}"
        AGENT_SESSION_REPO="$repo"
        return
        ;;
      *)
        printf '%sInvalid worktree selection.%s\n' "$UI_RED" "$UI_RESET" >&2
        ;;
      esac
    done
  done
}

agent_tmux_session() {
  local mode="$1" cwd="${2:-/workspace}" default_name="${3:-main}"
  local format=$'#{session_name}\t#{pane_current_path}\t#{session_windows} windows\t#{?session_attached,attached,detached}\tcreated #{t:session_created}'
  # kubectl exec supplies no locale, so force UTF-8 or tmux replaces TUI glyphs with underscores.
  local -a tmux_bash=(
    tmux -u
    set-option -g default-shell /bin/bash ';'
    set-option -g default-command /bin/bash ';'
    set-option -g default-terminal tmux-256color ';'
    set-option -g history-limit 100000 ';'
    set-option -g focus-events on ';'
    set-option -g status-style 'bg=colour234,fg=colour250' ';'
    set-option -g status-left-length 60 ';'
    set-option -g status-right-length 24 ';'
    set-option -g status-left '#[bg=colour24,fg=white,bold] #S #[default]' ';'
    set-option -g status-right '#[fg=colour245] %H:%M | %d %b ' ';'
    set-option -g window-status-format '#[fg=colour245] #I:#W ' ';'
    set-option -g window-status-current-format '#[bg=colour31,fg=white,bold] #I:#W#{?window_zoomed_flag, Z,} #[default]' ';'
    set-option -g mouse on ';'
  )
  cd "$cwd" || return 1

  case "$mode" in
    shell)
      exec /bin/bash
      ;;
    list)
      tmux -u list-sessions -F "$format" 2>/dev/null || printf 'No tmux sessions.\n'
      return
      ;;
  esac

  local -a rows=() names=() tmux_notice=()
  local row choice shortcut index session_name session_cwd session_windows session_state session_created status existing_choice
  local start_position=1
  mapfile -t rows < <(tmux -u list-sessions -F "$format" 2>/dev/null || true)
  for row in "${rows[@]}"; do
    names+=("${row%%$'\t'*}")
  done

  (( ${#rows[@]} > 0 )) && start_position=3
  while true; do
    choice="$(
      {
        printf 'new\t%screate a new session%s\t%sCtrl-N%s\n' \
          "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
        printf 'shell\t%splain shell%s\t%sCtrl-S%s\n' \
          "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
        for index in "${!rows[@]}"; do
          IFS=$'\t' read -r session_name session_cwd session_windows session_state session_created <<< "${rows[index]}"
          printf 'session:%d\t%s%s%s\t%s%s%s\t%s%s | %s | %s%s\n' \
            "$index" "$UI_GREEN" "$session_name" "$UI_RESET" \
            "$UI_DIM" "$session_cwd" "$UI_RESET" \
            "$UI_DIM" "$session_windows" "$session_state" "$session_created" "$UI_RESET"
        done
      } | fzf --ansi --layout=reverse --border --height=100% --bind="start:pos($start_position)" \
        --delimiter=$'\t' --with-nth=2.. --expect=esc,ctrl-n,ctrl-s --prompt='Session> ' \
        --header='Enter: attach or create | Ctrl-N: new | Ctrl-S: shell | Ctrl-C: quit'
    )" || return
    shortcut="${choice%%$'\n'*}"
    choice="${choice#*$'\n'}"
    case "$shortcut" in
      esc) continue ;;
      ctrl-n) choice=new ;;
      ctrl-s) choice=shell ;;
    esac
    choice="${choice%%$'\t'*}"
    case "$choice" in
      new) ;;
      shell) exec /bin/bash ;;
      session:*)
        index="${choice#session:}"
        exec "${tmux_bash[@]}" attach-session -t "${names[index]}"
        ;;
      *)
        printf '%sInvalid session selection.%s\n' "$UI_RED" "$UI_RESET" >&2
        return 1
        ;;
    esac

    while true; do
      if agent_choose_directory "${AGENT_SESSION_REPO:-}"; then
        status=0
      else
        status=$?
      fi
      [[ "$status" -eq 2 ]] && continue 2
      [[ "$status" -eq 0 ]] || return "$status"
      cwd="$AGENT_SESSION_CWD"
      default_name="$AGENT_SESSION_DEFAULT"
      tmux_notice=()
      if [[ -n "${AGENT_SESSION_NOTICE:-}" ]]; then
        tmux_notice=(';' display-message -d 5000 "$AGENT_SESSION_NOTICE")
      fi
      cd "$cwd" || return 1
      if ! tmux -u has-session -t "$default_name" 2>/dev/null; then
        break
      fi
      existing_choice="$(
        {
          printf 'cancel\t%scancel%s\t%schoose another worktree%s\n' \
            "$UI_CYAN" "$UI_RESET" "$UI_DIM" "$UI_RESET"
          printf 'resume\t%sresume existing session%s\t%s%s%s\n' \
            "$UI_GREEN" "$UI_RESET" "$UI_DIM" "$default_name" "$UI_RESET"
        } | fzf --ansi --layout=reverse --border --height=100% --bind='start:pos(2)' \
          --delimiter=$'\t' --with-nth=2.. --expect=esc --prompt='Existing session> ' \
          --header="A session named '$default_name' already exists | Enter: resume | Esc: choose another worktree | Ctrl-C: quit"
      )" || return
      shortcut="${existing_choice%%$'\n'*}"
      existing_choice="${existing_choice#*$'\n'}"
      [[ "$shortcut" == esc ]] && continue
      existing_choice="${existing_choice%%$'\t'*}"
      if [[ "$existing_choice" == resume ]]; then
        exec "${tmux_bash[@]}" attach-session -t "$default_name" "${tmux_notice[@]}"
      fi
    done
    break
  done
  exec "${tmux_bash[@]}" new-session -s "$default_name" -c "$cwd" "${tmux_notice[@]}"
}

agent_ssh_entry() {
  local mode="$1"
  AGENT_SESSION_CWD="${VICEGERENT_WORKSPACE_ROOT:-/workspace}"
  AGENT_SESSION_DEFAULT=main
  agent_tmux_session "$mode" "$AGENT_SESSION_CWD" "$AGENT_SESSION_DEFAULT"
}

usage() {
  cat <<EOF
${B}vicegerent${N} — operational CLI for the vicegerent infra-agent platform

${B}Usage:${N}
  ${C}vicegerent start${N}                        start the Kind cluster + host ToolHive/vMCP stack
  ${C}vicegerent stop${N}                         stop the host stack + Kind cluster
  ${C}vicegerent setup cluster${N}                create the Kind cluster
  ${C}vicegerent setup secrets platform${N}       provision platform-wide secrets (idempotent)
  ${C}vicegerent setup secrets agent <name>${N}   provision a named agent's secrets (idempotent)
  ${C}vicegerent setup mcp${N}                    set up host-side MCP prerequisites
  ${C}vicegerent install${N}                      (re-)install the platform via the staged Helm reconciler
  ${C}vicegerent logs${N}                         open the VictoriaLogs dashboard
  ${C}vicegerent creds <name>${N}                 show an agent's dashboard credentials and URL
  ${C}vicegerent ssh <name>${N}                   open a persistent tmux session inside an agent container
  ${C}vicegerent test gateway${N}                 run MCP gateway tests
  ${C}vicegerent test policies${N}                run MCP policy enforcement tests
  ${C}vicegerent test egress <name>${N}           run egress-proxy redaction/enforcement tests
  ${C}vicegerent host-packages <cmd>${N}           check or reconcile exact Homebrew package versions
  ${C}vicegerent mcp <cmd>${N}                    host ToolHive/vMCP stack controller (start/stop/status/…)
  ${C}vicegerent tui${N}                          open the host stack TUI dashboard
EOF
}

setup_usage() {
  cat <<EOF
${B}vicegerent setup${N} — one-time provisioning steps

  ${C}cluster${N}                create the Kind cluster; install Cilium with vicegerent install
                         (overridable env: KIND_CONFIG KIND_DOCKER_NETWORK
                          VICEGERENT_HOST_IP — the host address CoreDNS resolves
                          host.docker.internal to; set it if autodetection fails)
  ${C}secrets platform${N}       provision platform-wide Kubernetes Secrets + host ghostunnel material
  ${C}secrets agent <name>${N}   provision a named agent's Kubernetes Secrets
  ${C}mcp${N}                    install host MCP prerequisites (brew pkgs, venv, secrets provider)
                         then configure servers, and link the CLI onto PATH
EOF
}

# Patch in-cluster CoreDNS to resolve host.docker.internal: Kind's CoreDNS forwards
# to the pod's own loopback, not Docker's embedded resolver, so pods otherwise can't
# resolve it (that's how agentgateway reaches the host ghostunnel). Pin it to the
# detected host gateway IP. Idempotent — skipped if already present.
patch_coredns() {
  local cluster_name="$1" docker_network="$2"
  local ctx="kind-${cluster_name}"

  local corefile new
  corefile="$(kubectl --context "$ctx" -n kube-system get configmap coredns -o jsonpath='{.data.Corefile}')"

  if grep -q 'host.docker.internal' <<<"$corefile"; then
    ui_success "CoreDNS already patched (host.docker.internal); skipping."
    return
  fi

  # The probe resolves host.docker.internal from inside the network (Docker Desktop
  # provides it). Native Linux Docker does not, so fall back to the network's own
  # gateway address rather than Desktop's hardcoded 192.168.65.254, which would
  # bake a wrong IP into CoreDNS and break agentgateway -> host ghostunnel silently.
  local host_ip="${VICEGERENT_HOST_IP:-}"
  if [[ -z "$host_ip" ]]; then
    # getent on a dual-stack network can return an IPv6 row before the IPv4 one;
    # filter for IPv4 only so an AAAA hit doesn't get baked into the Corefile.
    host_ip="$(docker run --rm --network "$docker_network" alpine \
      sh -c 'getent hosts host.docker.internal 2>/dev/null' 2>/dev/null \
      | awk '/^([0-9]+\.){3}[0-9]+ / {print $1; exit}')"
  fi
  if [[ -z "$host_ip" ]]; then
    # println: kind's network is dual-stack, and range with no separator would glue
    # the IPv4 and IPv6 gateways into one unparseable token. Take the IPv4 one.
    host_ip="$(docker network inspect "$docker_network" \
      -f '{{ range .IPAM.Config }}{{ println .Gateway }}{{ end }}' 2>/dev/null \
      | awk '/^([0-9]+\.){3}[0-9]+$/ {print; exit}')"
  fi
  [[ -n "$host_ip" ]] || {
    ui_error "Could not determine the host IP reachable from docker network '${docker_network}'."
    ui_command "VICEGERENT_HOST_IP=<ip> ./vicegerent setup cluster" >&2
    exit 1
  }
  ui_info "CoreDNS will resolve host.docker.internal to ${host_ip}."
  new="$(awk -v ip="$host_ip" '{print} /^\.:53 \{/ && !d {
    print "    hosts {"; print "        " ip " host.docker.internal"; print "        fallthrough"; print "    }"; d=1}' <<<"$corefile")"

  kubectl --context "$ctx" -n kube-system create configmap coredns \
    --from-literal=Corefile="$new" --dry-run=client -o yaml \
    | kubectl --context "$ctx" -n kube-system apply -f -
  kubectl --context "$ctx" -n kube-system rollout restart deployment/coredns
}

# Create the Kind cluster with Kind's default CNI disabled. The staged Helm installer
# installs Cilium before any workloads that depend on CiliumNetworkPolicy.
cluster_setup() {
  require_kind_context
  local cluster_name="${KUBE_CONTEXT#kind-}"
  local kind_config="${KIND_CONFIG:-$REPO_ROOT/scripts/install/kind-config.yaml}"
  # Dedicated docker network so this cluster's node containers are isolated from the
  # default shared `kind` network and any other kind clusters.
  local docker_network="${KIND_DOCKER_NETWORK:-$cluster_name}"

  for cmd in kind kubectl docker; do
    command -v "$cmd" >/dev/null 2>&1 || { ui_error "$cmd is not installed or not on PATH"; exit 1; }
  done

  if kind get clusters 2>/dev/null | grep -qx "$cluster_name"; then
    ui_success "Kind cluster '${cluster_name}' already exists; skipping create."
  else
    ui_section "Creating Kind cluster '${cluster_name}'"
    ui_key_value "Docker network" "$docker_network"
    KIND_EXPERIMENTAL_DOCKER_NETWORK="$docker_network" \
      kind create cluster --name "$cluster_name" --config "$kind_config"
  fi
  ensure_kind_userns_hook_access "${cluster_name}-control-plane"

  # kind always installs local-path-provisioner + the default 'standard' StorageClass with
  # no flag to skip it. We don't use it -- every agent PVC pins csi-hostpath-sc, installed
  # by the storage stage of ./vicegerent install -- so remove it post-creation instead.
  # --ignore-not-found makes this safe to rerun; the namespace delete cascades onto its
  # Deployment/ServiceAccount/Role/RoleBinding.
  ui_info "Removing kind's local-path-provisioner and 'standard' default StorageClass…"
  kubectl --context "$KUBE_CONTEXT" delete storageclass standard --ignore-not-found
  kubectl --context "$KUBE_CONTEXT" delete clusterrole local-path-provisioner-role --ignore-not-found
  kubectl --context "$KUBE_CONTEXT" delete clusterrolebinding local-path-provisioner-bind --ignore-not-found
  kubectl --context "$KUBE_CONTEXT" delete namespace local-path-storage --ignore-not-found

  patch_coredns "$cluster_name" "$docker_network"
}

# Port-forward agentgateway, check the host MCP stack is running, run a test script,
# then tear everything down. Used by `test gateway` and `test policies`.
run_with_portforward() {
  local script="$1" mcp_status=0; shift

  mcp_py status >/dev/null || mcp_status=$?
  if (( mcp_status == 127 )); then
    exit 1
  fi
  if (( mcp_status != 0 )); then
    ui_error "Host MCP stack is not running. Start it first: ./vicegerent mcp start"
    exit 1
  fi

  require_kind_context

  # Port-forward agentgateway. PF_PID is global on purpose: the EXIT trap fires at
  # script scope, after this function returns, where a `local` would be unset (and
  # would trip `set -u`). The trap is the single teardown path.
  kubectl --context "$KUBE_CONTEXT" -n agentgateway-system \
    port-forward svc/agentgateway-proxy 8080:80 >/dev/null 2>&1 &
  PF_PID=$!
  trap 'kill "${PF_PID:-}" 2>/dev/null || true' EXIT INT TERM

  # Wait for port to open (max 15s). Use an assignment, not ((i++)) — under `set -e`
  # ((i++)) returns non-zero when i is 0 and would abort on the first iteration.
  local i=0
  while ! python3 -c "import socket; s=socket.create_connection(('127.0.0.1',8080),0.25); s.close()" 2>/dev/null; do
    i=$((i + 1))
    if [[ $i -ge 60 ]]; then
      ui_error "agentgateway port-forward did not become ready after 15s"
      exit 1
    fi
    sleep 0.25
  done

  # `|| rc=$?` so a failing test doesn't abort under `set -e` before teardown runs.
  export GATEWAY_URL="http://localhost:8080"
  local rc=0
  "$script" "$@" || rc=$?
  kill "${PF_PID:-}" 2>/dev/null || true
  trap - EXIT INT TERM
  return $rc
}

case "${1:-}" in
  start)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      echo "vicegerent start — start the Kind cluster, then bring up the host ToolHive stack"
      echo "  1. docker start <selected-kind-cluster>-control-plane   (start the Kind node container)"
      echo "  2. ./vicegerent mcp start                   (host-package preflight + ToolHive workloads + supervised services)"
      echo "  Extra args pass through to 'vicegerent mcp start' (e.g. --operator-vmcp or --caffeinate)."
      exit 0
    fi
    require_kind_context
    ui_section "Starting Vicegerent"
    ui_info "Starting Kind cluster…"
    docker start "$(kind_node_container)" >/dev/null
    ui_info "Waiting for Kind cluster readiness…"
    kubectl --context "$KUBE_CONTEXT" wait --for=condition=Ready node --all --timeout=60s
    ui_info "Starting host MCP stack…"
    mcp_py start "$@"
    ;;
  stop)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      echo "vicegerent stop — stop the host ToolHive stack, then stop the Kind cluster"
      echo "  1. ./vicegerent mcp stop                    (tears down every supervised process — vMCP, ghostunnel, rclone-s3, health-watch, caffeinate — and stops the ToolHive workloads)"
      echo "  2. docker stop <selected-kind-cluster>-control-plane     (stop the Kind node container to free CPU)"
      exit 0
    fi
    ui_section "Stopping Vicegerent"
    ui_info "Stopping host MCP stack…"
    mcp_py stop "$@"
    require_kind_context
    ui_info "Stopping Kind cluster…"
    exec docker stop "$(kind_node_container)"
    ;;
  setup)
    shift
    case "${1:-}" in
      cluster)
        shift
        [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && { setup_usage; exit 0; }
        # cluster_setup is configured entirely by env; reject a positional arg here
        # (most likely a mistaken cluster name) instead of silently ignoring it.
        [[ $# -eq 0 ]] || { echo "vicegerent setup cluster takes no arguments (configure it via env: VICEGERENT_KUBE_CONTEXT KIND_CONFIG KIND_DOCKER_NETWORK VICEGERENT_HOST_IP)" >&2; exit 2; }
        cluster_setup
        ;;
      secrets)
        shift
        case "${1:-}" in
          platform)
            shift
            exec "$REPO_ROOT/scripts/install/setup-secrets-platform.sh" "$@"
            ;;
          agent)
            shift
            [[ $# -ge 1 ]] || { echo "usage: vicegerent setup secrets agent <agent-name> [-y|--yes]" >&2; exit 2; }
            exec "$REPO_ROOT/scripts/install/setup-secrets-agent.sh" "$@"
            ;;
          --help|-h|"")
            echo "vicegerent setup secrets platform            →  platform-wide Kubernetes Secrets + host ghostunnel material"
            echo "vicegerent setup secrets agent <agent-name>  →  per-agent Kubernetes Secrets"
            exit 0
            ;;
          *)
            echo "unknown setup secrets target: $1 (expected 'platform' or 'agent')" >&2
            exit 1
            ;;
        esac
        ;;
      mcp)
        shift
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
          echo "vicegerent setup mcp — set up all host-side MCP prerequisites, then configure servers"
          echo "  Reconciles exact Homebrew package versions and the native Vicegerent notification helper,"
          echo "  the locked repository Python environment and thv secrets provider, then walks you through enabling/skipping each"
          echo "  MCP server and setting its secrets."
          echo "  Flags: -y/--yes (auto-approves the prerequisite installs; the per-server"
          echo "         configure step stays interactive)"
          exit 0
        fi
        exec "$REPO_ROOT/scripts/host/setup-host-mcp" "$@"
        ;;
      --help|-h|"")
        setup_usage
        exit 0
        ;;
      *)
        echo "unknown setup target: $1 (expected 'cluster', 'secrets', or 'mcp')" >&2
        setup_usage >&2
        exit 1
        ;;
    esac
    ;;
  install)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      echo "vicegerent install — (re-)install the platform via the staged Helm reconciler"
      echo "  Idempotent: reads stages/stages.yaml (control plane) + values.yaml (machine plane)"
      echo "  and runs helm upgrade --install --wait per stage. Copy values.example.yaml to"
      echo "  values.yaml first, and seed secrets with 'vicegerent setup secrets platform'."
      echo "  Flags: -y/--yes, --values <file>, --stage <name>, --from <name>."
      echo "  Env: RECREATE=1 (helm --force-replace), HELM_TIMEOUT, VALUES_FILE, DEFAULTS_FILE."
      exit 0
    fi
    require_kind_context
    ensure_kind_userns_hook_access "$(kind_node_container)"
    exec "$REPO_ROOT/scripts/install/install.sh" "$@"
    ;;
  logs)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      echo "vicegerent logs — port-forward VictoriaLogs and open its dashboard"
      exit 0
    fi
    [[ $# -eq 0 ]] || { echo "vicegerent logs takes no arguments" >&2; exit 2; }
    require_kind_context

    LOGS_URL='http://localhost:9428/select/vmui/?#/?g0.range_input=5m&g0.relative_time=last_5_minutes&query=*&refresh=3s'
    kubectl --context "$KUBE_CONTEXT" -n victoria-logs \
      port-forward svc/victoria-logs-server 9428:9428 >/dev/null 2>&1 &
    PF_PID=$!
    trap 'kill "${PF_PID:-}" 2>/dev/null || true' EXIT INT TERM

    i=0
    while ! python3 -c "import socket; s=socket.create_connection(('127.0.0.1',9428),0.25); s.close()" 2>/dev/null; do
      kill -0 "$PF_PID" 2>/dev/null || { ui_error "VictoriaLogs port-forward exited before becoming ready"; exit 1; }
      i=$((i + 1))
      [[ $i -lt 60 ]] || { ui_error "VictoriaLogs port-forward did not become ready after 15s"; exit 1; }
      sleep 0.25
    done

    if command -v open >/dev/null 2>&1; then
      open "$LOGS_URL"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$LOGS_URL"
    else
      ui_error "No browser opener found (expected 'open' or 'xdg-open')"
      exit 1
    fi
    ui_success "VictoriaLogs dashboard opened."
    ui_key_value "URL" "$LOGS_URL"
    ui_info "Press Ctrl-C to stop the port-forward."
    wait "$PF_PID"
    ;;
  creds)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      echo "vicegerent creds <agent-name> — print credentials and dashboard URL"
      exit 0
    fi
    [[ $# -ge 1 ]] || { echo "usage: vicegerent creds <agent-name>" >&2; exit 2; }
    AGENT="$(echo "$1" | tr '[:upper:]' '[:lower:]')"; shift
    "$REPO_ROOT/scripts/dashboard/dashboard-basic-cred.sh" "$AGENT" "$@"
    ;;
  ssh)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      cat <<'EOF'
vicegerent ssh <agent-name> [--list | --shell]

Choose an existing tmux session or create a new one. New sessions can select a
repository and existing worktree, create or prune a linked worktree, or stay in
/workspace. Existing sessions show the cwd of their active pane so worktree
ownership is visible before attaching. From the worktree list, Ctrl-P opens the
prune selector; pruning keeps any checked-out branch.

  --list            list sessions without attaching
  --shell           open a plain shell without tmux

Detach without stopping the session with Ctrl-b d. Sessions survive a lost
kubectl exec connection, but not an agent Pod or container restart.
EOF
      exit 0
    fi
    [[ $# -ge 1 ]] || { echo "usage: vicegerent ssh <agent-name> [--list | --shell]" >&2; exit 2; }
    AGENT="$(echo "$1" | tr '[:upper:]' '[:lower:]')"; shift
    SSH_MODE=auto
    case "${1:-}" in
      "") ;;
      --list)
        [[ $# -eq 1 ]] || { echo "usage: vicegerent ssh <agent-name> --list" >&2; exit 2; }
        SSH_MODE=list
        ;;
      --shell)
        [[ $# -eq 1 ]] || { echo "usage: vicegerent ssh <agent-name> --shell" >&2; exit 2; }
        SSH_MODE=shell
        ;;
      *)
        echo "usage: vicegerent ssh <agent-name> [--list | --shell]" >&2
        exit 2
        ;;
    esac
    require_kind_context
    # The agent-sandbox controller names the Pod after the Sandbox/agent; every agent's
    # app container is named 'agent' regardless of the Sandbox/agent name.
    # Do not exec: an interactive selector can leave terminal modes enabled on failure.
    [[ "$SSH_MODE" == auto ]] && trap restore_terminal EXIT
    REMOTE_COLORS="$(printf \
      'UI_BOLD=%q; UI_CYAN=%q; UI_GREEN=%q; UI_YELLOW=%q; UI_RED=%q; UI_DIM=%q; UI_RESET=%q;' \
      "$UI_BOLD" "$UI_CYAN" "$UI_GREEN" "$UI_YELLOW" "$UI_RED" "$UI_DIM" "$UI_RESET")"
    REMOTE_COMMAND="$REMOTE_COLORS $(declare -f agent_fzf_input); $(declare -f agent_choose_directory); $(declare -f agent_tmux_session); $(declare -f agent_ssh_entry); agent_ssh_entry \"\$@\""
    KUBECTL_TTY=(-it)
    [[ "$SSH_MODE" == list ]] && KUBECTL_TTY=()
    if kubectl --context "$KUBE_CONTEXT" -n agent-sandbox exec "${KUBECTL_TTY[@]}" "$AGENT" -c agent \
      -- bash -c "$REMOTE_COMMAND" bash "$SSH_MODE"; then
      status=0
    else
      status=$?
    fi
    if [[ "$SSH_MODE" == auto ]]; then
      trap - EXIT
      restore_terminal
    fi
    exit "$status"
    ;;
  test)
    shift
    case "${1:-}" in
      gateway)
        shift
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
          echo "vicegerent test gateway [keyword] — probe MCP endpoints (auto port-forwards agentgateway, requires the host MCP stack running)"
          echo "  no keyword: sample ranked tool-discovery results per backend"
          echo "  keyword:    search find_tool for matching tools (e.g. 'kubernetes', 'context', 'notion')"
          exit 0
        fi
        run_with_portforward "$REPO_ROOT/scripts/test-mcp-gateway.sh" "$@"
        ;;
      policies)
        shift
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
          echo "vicegerent test policies — run MCP policy enforcement tests (auto port-forwards agentgateway, requires the host MCP stack running)"
          exit 0
        fi
        run_with_portforward "$REPO_ROOT/scripts/test-mcp-policies.sh" "$@"
        ;;
      egress)
        shift
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
          echo "vicegerent test egress <agent-name> — run the egress-proxy redaction/enforcement tests against a running agent sandbox"
          exit 0
        fi
        [[ $# -ge 1 ]] || { echo "usage: vicegerent test egress <agent-name>" >&2; exit 2; }
        AGENT="$(echo "$1" | tr '[:upper:]' '[:lower:]')"; shift
        AGENT_LABEL="$AGENT" exec "$REPO_ROOT/scripts/test-egress-redaction.sh" "$@"
        ;;
      --help|-h|"")
        echo "vicegerent test gateway              →  scripts/test-mcp-gateway.sh"
        echo "vicegerent test policies             →  scripts/test-mcp-policies.sh"
        echo "vicegerent test egress <agent-name>  →  scripts/test-egress-redaction.sh"
        exit 0
        ;;
      *)
        echo "unknown test subcommand: $1" >&2
        exit 1
        ;;
    esac
    ;;
  host-packages)
    shift
    case "${1:-}" in
      check|apply)
        exec python3 "$REPO_ROOT/host/brew/reconcile.py" "$@"
        ;;
      --help|-h|"")
        echo "vicegerent host-packages check       report exact-version drift (read-only)"
        echo "vicegerent host-packages apply       install, link, verify, and pin declared versions"
        exit 0
        ;;
      *)
        echo "unknown host-packages command: $1 (expected 'check' or 'apply')" >&2
        exit 1
        ;;
    esac
    ;;
  mcp)
    shift
    case "${1:-}" in
      --help|-h|"")
        cat <<EOF
${B}vicegerent mcp${N} — host-side ToolHive/vMCP stack controller

  ${C}configure${N}             interactively enable/skip each server + set its secrets
  ${C}enable${N} KEY            enable a server (persists; started on next start)
  ${C}disable${N} KEY           disable a server (stops it; ToolHive won't run it)
  ${C}start${N} [OPTIONS]       bring up enabled workloads + vMCP + ghostunnel + rclone-s3 + health-watch
                              --operator-vmcp also exposes the unscoped host endpoint on :4484
  ${C}stop${N}                  stop the supervised stack + ToolHive workloads
  ${C}status${N}                workload + supervised-process state
  ${C}logs${N} PROC             tail a supervised process log
  ${C}doctor${N}                check binaries, thv secrets provider + the enabled servers' secrets, kind

Prerequisites and per-server configuration are set up once with 'vicegerent setup mcp'.
The interactive dashboard is 'vicegerent tui'.
Run 'vicegerent mcp COMMAND --help' for per-command options.
EOF
        exit 0
        ;;
      *)
        mcp_py "$@"
        ;;
    esac
    ;;
  tui)
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      echo "vicegerent tui — open the interactive host stack dashboard (textual)"
      exit 0
    fi
    mcp_py tui "$@"
    ;;
  help|--help|-h|"")
    usage
    exit 0
    ;;
  *)
    echo "unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
