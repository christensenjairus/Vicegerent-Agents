{
  "group": "vicegerent",
  "vmcp_port": 4483,
  "servers": [
    {
      "name": "kubernetes",
      "description": "Read-only Kubernetes access \u2014 inspect resources, pods, logs, and Helm releases across the local kind cluster and, via an exec-plugin kubeconfig, a real EKS cluster.",
      "enabled": false,
      "type": "registry",
      "registry": "harbor.hahomelabs.com/vicegerent/kubernetes-mcp-server:v0.2.2",
      "transport": "stdio",
      "server_args": ["--read-only","--toolsets=config,core,helm"],
      "kind_cluster": "vicegerent",
      "run_flags": ["--network", "vicegerent", "--isolate-network=false"],
      "network": {
        "exempt": true
      },
      "params": [
        {
          "name": "kubeconfig",
          "prompt": "Kubeconfig path for the target cluster (blank = auto-generate from the kind 'vicegerent' cluster)",
          "apply": "kubeconfig",
          "secret": true
        },
        {
          "name": "aws_config_dir",
          "prompt": "Path to AWS config dir, for kubeconfigs using AWS IAM/exec auth against a real EKS cluster (blank = ~/.aws)",
          "apply": "aws_config"
        }
      ],
      "tools": [
        "configuration_contexts_list", "events_list", "helm_list", "namespaces_list",
        "nodes_log", "nodes_stats_summary", "nodes_top", "pods_get", "pods_list",
        "pods_list_in_namespace", "pods_log", "pods_top", "resources_get", "resources_list"
      ]
    },
    {
      "name": "gitlab",
      "description": "GitLab issues and merge-request lifecycle (create/update/review/labels, pipeline status/logs, retry a failed job) \u2014 the MR-object actions that plain git over SSH can't do, short of leaving comments.",
      "enabled": false,
      "type": "npx",
      "package": "@zereight/mcp-gitlab@2.1.46",
      "env": {"USE_PIPELINE": "true"},
      "secrets": [{"name": "gitlab_token", "prompt": "GitLab personal access token", "target": "GITLAB_PERSONAL_ACCESS_TOKEN"}],
      "network": {
        "host_from_param": "api_url"
      },
      "params": [
        {
          "name": "api_url",
          "prompt": "GitLab API URL (e.g. https://gitlab.example.com/api/v4)",
          "apply": "server_arg",
          "template": "--api-url={value}",
          "required": true,
          "secret": true
        }
      ],
      "tools": [
        "get_project",
        "get_issue", "list_issues", "my_issues",
        "list_issue_discussions", "list_issue_links", "get_issue_link",
        "list_todos", "mark_todo_done", "mark_all_todos_done",
        "list_labels", "get_label",
        "create_merge_request", "get_merge_request", "get_merge_request_diffs",
        "list_merge_request_diffs", "get_merge_request_conflicts", "list_merge_request_changed_files",
        "get_merge_request_file_diff", "list_merge_request_versions", "get_merge_request_version",
        "get_branch_diffs", "update_merge_request",
        "mr_discussions",
        "get_merge_request_note", "get_merge_request_notes",
        "get_draft_note", "list_draft_notes",
        "list_merge_requests",
        "get_merge_request_approval_state",
        "list_pipelines", "get_pipeline", "list_pipeline_jobs", "get_pipeline_job",
        "get_pipeline_job_output", "retry_pipeline_job"
      ]
    },
    {
      "name": "github",
      "description": "GitHub pull-request lifecycle \u2014 inspect and manage PRs (routine git goes over SSH, not MCP).",
      "enabled": false,
      "type": "registry",
      "registry": "ghcr.io/github/github-mcp-server:v1.8.0",
      "transport": "stdio",
      "env": {
        "GITHUB_TOOLSETS": "all"
      },
      "secrets": [{"name": "github_token", "prompt": "GitHub personal access token", "target": "GITHUB_PERSONAL_ACCESS_TOKEN"}],
      "network": {
        "allow_hosts": ["github.com", "api.github.com"]
      },
      "tools": [
        "get_me",
        "pull_request_read",
        "issue_read", "list_issues", "search_issues",
        "create_pull_request", "update_pull_request",
        "list_pull_requests", "search_pull_requests", "request_copilot_review",
        "update_pull_request_branch"
      ]
    },
    {
      "name": "tavily",
      "description": "Tavily web search and content extraction over arbitrary public URLs.",
      "enabled": false,
      "type": "npx",
      "package": "tavily-mcp@0.2.22",
      "network": {
        "allow_hosts": ["api.tavily.com"]
      },
      "secrets": [{"name": "tavily_api_key", "prompt": "Tavily API key", "target": "TAVILY_API_KEY"}],
      "tools": ["tavily_search", "tavily_extract", "tavily_crawl", "tavily_map", "tavily_research"]
    },
    {
      "name": "firecrawl",
      "description": "Firecrawl web scraping, crawling, and extraction over arbitrary public URLs.",
      "enabled": false,
      "type": "npx",
      "package": "firecrawl-mcp@3.23.4",
      "network": {
        "allow_hosts": ["api.firecrawl.dev"]
      },
      "secrets": [{"name": "firecrawl_api_key", "prompt": "Firecrawl API key", "target": "FIRECRAWL_API_KEY"}],
      "tools": [
        "firecrawl_scrape", "firecrawl_map", "firecrawl_search", "firecrawl_search_feedback",
        "firecrawl_feedback", "firecrawl_crawl", "firecrawl_check_crawl_status", "firecrawl_extract",
        "firecrawl_agent", "firecrawl_agent_status", "firecrawl_interact", "firecrawl_interact_stop",
        "firecrawl_parse", "firecrawl_monitor_create", "firecrawl_monitor_list", "firecrawl_monitor_get",
        "firecrawl_monitor_update", "firecrawl_monitor_delete", "firecrawl_monitor_run",
        "firecrawl_monitor_checks", "firecrawl_monitor_check", "firecrawl_research_search_papers",
        "firecrawl_research_inspect_paper", "firecrawl_research_related_papers",
        "firecrawl_research_read_paper", "firecrawl_research_search_github",
        "firecrawl_developer_search"
      ]
    },
    {
      "name": "notion",
      "description": "Notion workspace \u2014 search and read pages, comments, teams, and users, and create/update pages and comments.",
      "enabled": false,
      "type": "remote",
      "registry": "notion-remote",
      "network": {
        "allow_hosts": ["mcp.notion.com"]
      },
      "run_flags": ["--remote-auth-callback-port", "8777", "--remote-auth-timeout", "3m"],
      "tools": [
        "notion-search", "notion-fetch", "notion-get-comments", "notion-get-teams",
        "notion-get-users",
        "notion-create-pages", "notion-update-page", "notion-create-comment"
      ]
    },
    {
      "name": "linear",
      "description": "Linear issue and project tracking \u2014 issues, comments, projects, labels, statuses, teams, users, and docs (read+write, no deletes).",
      "enabled": false,
      "type": "remote",
      "registry": "linear",
      "network": {
        "allow_hosts": ["mcp.linear.app"]
      },
      "run_flags": ["--remote-auth-callback-port", "8778", "--remote-auth-timeout", "3m"],
      "tools": [
        "list_comments", "save_comment", "list_cycles", "get_document", "list_documents",
        "get_issue", "list_issues", "save_issue", "list_issue_statuses",
        "get_issue_status", "list_issue_labels", "create_issue_label", "list_projects",
        "get_project", "save_project", "list_project_labels",
        "list_teams", "get_team", "list_users", "get_user", "search_documentation"
      ]
    },
    {
      "name": "jira",
      "description": "Jira issue tracking \u2014 direct issue reads plus scoped workflow writes (read+write, no deletes).",
      "enabled": false,
      "type": "registry",
      "registry": "ghcr.io/sooperset/mcp-atlassian:0.23.0",
      "transport": "stdio",
      "network": {
        "host_from_secret": "jira_url"
      },
      "env": {
        "READ_ONLY_MODE": "false",
        "JIRA_PROJECTS_FILTER": "CHANGE",
        "TOOLSETS": "all"
      },
      "secrets": [
        {"name": "jira_url", "prompt": "Jira URL", "target": "JIRA_URL"},
        {"name": "jira_username", "prompt": "Jira username", "target": "JIRA_USERNAME"},
        {"name": "jira_api_token", "prompt": "Jira API token", "target": "JIRA_API_TOKEN"}
      ],
      "tools": [
        "jira_get_issue", "jira_get_project_issues", "jira_get_transitions",
        "jira_create_issue", "jira_update_issue", "jira_add_comment", "jira_transition_issue",
        "jira_create_issue_link", "jira_link_to_epic"
      ]
    },
    {
      "name": "grafana",
      "description": "Grafana observability, read-only \u2014 search dashboards and datasources and query Prometheus, Loki, VictoriaLogs, asserts, and annotations.",
      "enabled": false,
      "type": "registry",
      "registry": "docker.io/grafana/mcp-grafana:1.0.0",
      "transport": "stdio",
      "server_args": ["--transport", "stdio", "--disable-write", "--disable-proxied"],
      "network": {
        "host_from_secret": "grafana_url"
      },
      "tools": [
        "search_dashboards", "search_folders", "list_datasources", "get_datasource",
        "check_datasources_health", "get_dashboard_by_uid", "get_dashboard_panel_queries",
        "get_dashboard_property", "get_dashboard_summary", "query_prometheus", "query_prometheus_histogram",
        "list_prometheus_metric_names", "list_prometheus_metric_metadata", "list_prometheus_label_names",
        "list_prometheus_label_values", "get_assertions", "get_annotations", "get_annotation_tags",
        "get_panel_image", "query_loki_logs", "query_loki_stats", "list_loki_label_names",
        "list_loki_label_values"
      ],
      "secrets": [
        {"name": "grafana_url", "prompt": "Grafana URL", "target": "GRAFANA_URL"},
        {"name": "grafana_service_account_token", "prompt": "Grafana service account token", "target": "GRAFANA_SERVICE_ACCOUNT_TOKEN"}
      ]
    },
    {
      "name": "grafana_secondary",
      "description": "Secondary Grafana observability instance — same as 'grafana', pointed at its own instance via separate secrets.",
      "enabled": false,
      "type": "registry",
      "registry": "docker.io/grafana/mcp-grafana:1.0.0",
      "transport": "stdio",
      "server_args": ["--transport", "stdio", "--disable-write", "--disable-proxied"],
      "network": {
        "host_from_secret": "grafana_secondary_url"
      },
      "tools": [
        "search_dashboards", "search_folders", "list_datasources", "get_datasource",
        "check_datasources_health", "get_dashboard_by_uid", "get_dashboard_panel_queries",
        "get_dashboard_property", "get_dashboard_summary", "query_prometheus", "query_prometheus_histogram",
        "list_prometheus_metric_names", "list_prometheus_metric_metadata", "list_prometheus_label_names",
        "list_prometheus_label_values", "get_assertions", "get_annotations", "get_annotation_tags",
        "get_panel_image", "query_loki_logs", "query_loki_stats", "list_loki_label_names",
        "list_loki_label_values"
      ],
      "secrets": [
        {"name": "grafana_secondary_url", "prompt": "Secondary Grafana URL", "target": "GRAFANA_URL"},
        {"name": "grafana_secondary_service_account_token", "prompt": "Secondary Grafana service account token", "target": "GRAFANA_SERVICE_ACCOUNT_TOKEN"}
      ]
    },
    {
      "name": "alertmanager",
      "description": "Prometheus Alertmanager \u2014 alerts, silences, alert groups, and status (read+write, including create/delete silence).",
      "enabled": false,
      "type": "npx",
      "package": "mcp-alertmanager@2.1.1",
      "network": {
        "host_from_param": "url"
      },
      "params": [
        {
          "name": "url",
          "prompt": "Alertmanager API URL (e.g. https://alertmanager.example.com)",
          "apply": "server_arg",
          "template": "--url={value}",
          "required": true,
          "secret": true
        }
      ],
      "tools": [
        "getAlerts", "getAlertGroups", "getCriticalAlerts", "getAlertingSummary",
        "getSilences", "createSilence", "deleteSilence",
        "getAlertmanagerStatus", "getReceivers",
        "investigateAlert", "getAlertHistory", "correlateAlerts"
      ]
    },
    {
      "name": "alertmanager_secondary",
      "description": "Secondary Prometheus Alertmanager instance — same as 'alertmanager', pointed at its own instance via a separate secret.",
      "enabled": false,
      "type": "npx",
      "package": "mcp-alertmanager@2.1.1",
      "network": {
        "host_from_param": "url"
      },
      "params": [
        {
          "name": "url",
          "prompt": "Secondary Alertmanager API URL (e.g. https://alertmanager-secondary.example.com)",
          "apply": "server_arg",
          "template": "--url={value}",
          "required": true,
          "secret": true
        }
      ],
      "tools": [
        "getAlerts", "getAlertGroups", "getCriticalAlerts", "getAlertingSummary",
        "getSilences", "createSilence", "deleteSilence",
        "getAlertmanagerStatus", "getReceivers",
        "investigateAlert", "getAlertHistory", "correlateAlerts"
      ]
    },
    {
      "name": "pagerduty",
      "description": "PagerDuty incident triage \u2014 read incidents, schedules, on-call, services, teams, users, and analytics, plus acknowledge/resolve/note on existing incidents (no incident creation).",
      "enabled": false,
      "type": "registry",
      "registry": "ghcr.io/stacklok/dockyard/uvx/pagerduty-mcp:1.1.0",
      "transport": "stdio",
      "server_args": ["--enable-write-tools"],
      "network": {
        "allow_hosts": ["api.pagerduty.com"]
      },
      "tools": [
        "get_incident", "list_incidents", "get_past_incidents", "get_related_incidents",
        "get_outlier_incident", "get_alert_from_incident", "list_alerts_from_incident", "list_incident_notes",
        "manage_incidents", "add_note_to_incident",
        "get_schedule", "list_schedules", "list_schedule_users", "list_oncalls",
        "get_schedule_v3_rotation", "get_schedule_v3_override", "get_schedule_v3_custom_shift", "get_schedule_v3_rotation_event",
        "list_schedule_v3_rotations", "list_schedule_v3_overrides", "list_schedule_v3_custom_shifts", "list_schedule_v3_rotation_events",
        "get_service", "list_services", "get_team", "list_teams", "list_team_members",
        "get_user_data", "list_users", "get_escalation_policy", "list_escalation_policies",
        "get_incident_metrics_all", "get_incident_metrics_by_service", "get_incident_metrics_by_team",
        "get_responder_metrics", "get_responder_load_metrics"
      ],
      "secrets": [{"name": "pagerduty_user_api_key", "prompt": "PagerDuty user API key", "target": "PAGERDUTY_USER_API_KEY"}]
    },
    {
      "name": "pagerduty_secondary",
      "description": "Secondary PagerDuty instance — same as 'pagerduty', authenticated against its own account via a separate secret.",
      "enabled": false,
      "type": "registry",
      "registry": "ghcr.io/stacklok/dockyard/uvx/pagerduty-mcp:1.1.0",
      "transport": "stdio",
      "server_args": ["--enable-write-tools"],
      "network": {
        "allow_hosts": ["api.pagerduty.com"]
      },
      "tools": [
        "get_incident", "list_incidents", "get_past_incidents", "get_related_incidents",
        "get_outlier_incident", "get_alert_from_incident", "list_alerts_from_incident", "list_incident_notes",
        "manage_incidents", "add_note_to_incident",
        "get_schedule", "list_schedules", "list_schedule_users", "list_oncalls",
        "get_schedule_v3_rotation", "get_schedule_v3_override", "get_schedule_v3_custom_shift", "get_schedule_v3_rotation_event",
        "list_schedule_v3_rotations", "list_schedule_v3_overrides", "list_schedule_v3_custom_shifts", "list_schedule_v3_rotation_events",
        "get_service", "list_services", "get_team", "list_teams", "list_team_members",
        "get_user_data", "list_users", "get_escalation_policy", "list_escalation_policies",
        "get_incident_metrics_all", "get_incident_metrics_by_service", "get_incident_metrics_by_team",
        "get_responder_metrics", "get_responder_load_metrics"
      ],
      "secrets": [{"name": "pagerduty_secondary_user_api_key", "prompt": "Secondary PagerDuty user API key", "target": "PAGERDUTY_USER_API_KEY"}]
    },
    {
      "name": "elastic",
      "description": "Elastic Agent Builder (Kibana) \u2014 read-only search and analysis over Elastic data.",
      "enabled": false,
      "type": "remote",
      "registry_from_param": "kibana_url",
      "transport": "streamable-http",
      "network": {
        "host_from_param": "kibana_url",
        "allow_ports": [443]
      },
      "params": [
        {
          "name": "kibana_url",
          "prompt": "Elastic Kibana Agent Builder MCP URL, e.g. https://<your-kibana-host>/api/agent_builder/mcp (no port suffix -- Kibana serves this on the HTTPS default 443)",
          "required": true,
          "secret": true
        },
        {
          "name": "api_key",
          "prompt": "Elastic API key -- paste just the encoded key from Kibana Stack Management > Security > API keys (read-only Agent Builder role). The 'ApiKey ' Authorization scheme prefix is added automatically.",
          "apply": "remote_header",
          "header": "Authorization",
          "required": true,
          "secret": true,
          "sensitive": true,
          "value_prefix": "ApiKey "
        }
      ],
      "tools": [
        "platform_streams_list_streams", "platform_streams_get_stream", "platform_streams_get_schema",
        "platform_streams_get_data_quality", "platform_streams_get_lifecycle_stats",
        "platform_streams_query_documents", "platform_streams_get_failed_documents",
        "platform_core_search", "platform_core_get_document_by_id", "platform_core_execute_esql",
        "platform_core_generate_esql", "platform_core_get_index_mapping", "platform_core_list_indices",
        "platform_core_index_explorer", "platform_core_product_documentation",
        "platform_core_integration_knowledge", "platform_core_cases",
        "platform_core_get_workflow_execution_status",
        "security_attack_discovery_search", "security_security_labs_search", "security_alerts",
        "security_get_entity", "security_search_entities",
        "observability_get_trace_change_points"
      ]
    },
    {
      "name": "aws",
      "description": "AWS access via aws-api-mcp-server \u2014 read-only, multi-profile AWS CLI execution (call_aws) and natural-language command suggestions across the operator's configured profiles.",
      "enabled": false,
      "type": "registry",
      "registry": "harbor.hahomelabs.com/vicegerent/aws-api-mcp-server:v0.1.2",
      "transport": "stdio",
      "env": {
        "READ_OPERATIONS_ONLY": "true",
        "AWS_REGION": "us-west-2",
        "AWS_API_MCP_TELEMETRY": "false"
      },
      "network": {
        "allow_hosts": [".amazonaws.com", ".api.aws"]
      },
      "params": [
        {
          "name": "aws_config_dir",
          "prompt": "Path to your AWS config dir (blank = ~/.aws). Mounted read-only; refresh SSO tokens host-side with `aws sso login`.",
          "apply": "aws_config"
        },
        {
          "name": "cred_watch_profile",
          "prompt": "AWS profile for mcp-health-watch's credential-expiry check to poll -- set to the SSO profile you work against so the pre-expiry warning scopes to that login (blank = whichever AWS_PROFILE/[default] resolves to, no --profile flag)"
        }
      ],
      "tools": [
        "call_aws",
        "suggest_aws_commands"
      ]
    },
    {
      "name": "aws_profiles",
      "description": "Hidden companion to the `aws` backend \u2014 lists the available AWS profile names so the agent knows which --profile values call_aws accepts (enabled/disabled together with aws, never configured on its own).",
      "enabled": false,
      "companion_of": "aws",
      "type": "registry",
      "registry": "harbor.hahomelabs.com/vicegerent/aws-profiles-mcp:v0.2.1",
      "transport": "stdio",
      "network": {
        "none": true
      },
      "params": [
        {
          "name": "aws_config_dir",
          "prompt": "Path to your AWS config dir (blank = ~/.aws). Mounted read-only.",
          "apply": "aws_config"
        }
      ],
      "tools": [
        "list"
      ]
    }
  ]
}
