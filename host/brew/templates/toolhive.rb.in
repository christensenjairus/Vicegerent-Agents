# Generated by host/brew/generate.py; edit host/brew/templates/toolhive.rb.in instead.
class @CLASS_NAME@ < Formula
  desc "ToolHive manager for MCP servers"
  homepage "https://github.com/stacklok/toolhive"
  version "@VERSION@"
  license "Apache-2.0"
  keg_only :versioned_formula

  on_macos do
    if Hardware::CPU.intel?
      url "@URL_DARWIN_AMD64@"
      sha256 "@SHA_DARWIN_AMD64@" # pragma: allowlist secret
    end
    if Hardware::CPU.arm?
      url "@URL_DARWIN_ARM64@"
      sha256 "@SHA_DARWIN_ARM64@" # pragma: allowlist secret
    end
  end

  on_linux do
    if Hardware::CPU.intel? && Hardware::CPU.is_64_bit?
      url "@URL_LINUX_AMD64@"
      sha256 "@SHA_LINUX_AMD64@" # pragma: allowlist secret
    end
    if Hardware::CPU.arm? && Hardware::CPU.is_64_bit?
      url "@URL_LINUX_ARM64@"
      sha256 "@SHA_LINUX_ARM64@" # pragma: allowlist secret
    end
  end

  def install
    bin.install "thv"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/thv version")
  end
end
