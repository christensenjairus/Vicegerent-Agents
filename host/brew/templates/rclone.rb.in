# Generated by host/brew/generate.py; edit host/brew/templates/rclone.rb.in instead.
class @CLASS_NAME@ < Formula
  desc "Rsync for cloud storage"
  homepage "https://rclone.org/"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@" # pragma: allowlist secret
  license "MIT"
  keg_only :versioned_formula

  depends_on "go" => :build

  def install
    ldflags = %W[-X github.com/rclone/rclone/fs.Version=v#{version}]
    tags = "brew" if OS.mac?
    system "go", "build", *std_go_args(output: bin/"rclone", ldflags:, tags:)
    man1.install "rclone.1"
    system bin/"rclone", "genautocomplete", "bash", "rclone.bash"
    system bin/"rclone", "genautocomplete", "zsh", "_rclone"
    system bin/"rclone", "genautocomplete", "fish", "rclone.fish"
    bash_completion.install "rclone.bash" => "rclone"
    zsh_completion.install "_rclone"
    fish_completion.install "rclone.fish"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rclone version")
  end
end
