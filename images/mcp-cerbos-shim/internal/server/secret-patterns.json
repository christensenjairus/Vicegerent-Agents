[
  {
    "name": "ssh_private_key",
    "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |ED25519 |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]+?-----END (?:RSA |EC |OPENSSH |DSA |ED25519 |ENCRYPTED )?PRIVATE KEY-----"
  },
  {
    "name": "slack_bot_token",
    "regex": "xox[bpraescd]-[A-Za-z0-9\\-_]+"
  },
  {
    "name": "slack_app_token",
    "regex": "xapp-[A-Za-z0-9\\-_]+"
  },
  {
    "name": "http_bearer_token",
    "regex": "(?i)\\bBearer\\s+[A-Za-z0-9\\-._~+/]+=*"
  },
  {
    "name": "http_basic_auth",
    "regex": "(?i)\\bBasic\\s+[A-Za-z0-9+/]+=*"
  },
  {
    "name": "aws_access_key_id",
    "regex": "\\b(?:AKIA|ASIA|AROA|AIDA)[A-Z0-9]{16}\\b"
  },
  {
    "name": "github_token",
    "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"
  },
  {
    "name": "gitlab_token",
    "regex": "\\bglpat-[A-Za-z0-9_\\-]{20,}\\b"
  },
  {
    "name": "google_api_key",
    "regex": "\\bAIza[A-Za-z0-9_\\-]{35}\\b"
  },
  {
    "name": "openai_api_key",
    "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_\\-]{20,}\\b"
  },
  {
    "name": "anthropic_api_key",
    "regex": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}\\b"
  },
  {
    "name": "stripe_api_key",
    "regex": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b"
  },
  {
    "name": "notion_token",
    "regex": "\\bntn_[A-Za-z0-9]{20,}\\b"
  },
  {
    "name": "twilio_api_key",
    "regex": "\\bSK[a-f0-9]{32}\\b"
  },
  {
    "name": "npm_token",
    "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"
  },
  {
    "name": "generic_jwt",
    "regex": "\\beyJ[A-Za-z0-9_\\-]+\\.eyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\b"
  },
  {
    "name": "us_ssn",
    "regex": "\\b(?:0(?:0[1-9]|[1-9][0-9])|[1-5][0-9]{2}|6(?:[0-5][0-9]|6[0-57-9]|[7-9][0-9])|[78][0-9]{2})-(?:0[1-9]|[1-9][0-9])-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})\\b"
  },
  {
    "name": "credit_card_visa",
    "regex": "\\b4(?:[0-9]{12}|[0-9]{15}|[0-9]{18})\\b"
  },
  {
    "name": "credit_card_mastercard",
    "regex": "\\b(?:5[1-5][0-9]{14}|(?:222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)[0-9]{12})\\b"
  },
  {
    "name": "credit_card_amex",
    "regex": "\\b3[47][0-9]{13}\\b"
  },
  {
    "name": "credit_card_discover",
    "regex": "\\b(?:6011[0-9]{12}|65[0-9]{14}|64[4-9][0-9]{13}|622(?:12[6-9]|1[3-9][0-9]|[2-8][0-9]{2}|9(?:[01][0-9]|2[0-5]))[0-9]{10})\\b"
  },
  {
    "name": "us_phone_number",
    "regex": "(?:\\+?1[-.\\s]?)?(?:\\([0-9]{3}\\)[-.\\s]?|[0-9]{3}[-.\\s])[0-9]{3}[-.\\s][0-9]{4}\\b"
  }
]
