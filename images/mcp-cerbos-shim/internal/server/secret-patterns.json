[
  {
    "name": "ssh_private_key",
    "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |ED25519 |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]+?-----END (?:RSA |EC |OPENSSH |DSA |ED25519 |ENCRYPTED )?PRIVATE KEY-----"
  },
  {
    "name": "slack_bot_token",
    "regex": "xox[bpraescd]-[A-Za-z0-9\\-_]+"
  },
  {
    "name": "slack_app_token",
    "regex": "xapp-[A-Za-z0-9\\-_]+"
  },
  {
    "name": "http_bearer_token",
    "regex": "(?i)\\bBearer[ \\t]+[A-Za-z0-9\\-._~+/]+=*",
    "modelResponse": false
  },
  {
    "name": "http_basic_auth",
    "regex": "(?i)\\bBasic[ \\t]+[A-Za-z0-9+/]+=*",
    "modelResponse": false
  },
  {
    "name": "aws_access_key_id",
    "regex": "\\b(?:AKIA|ASIA|AROA|AIDA)[A-Z0-9]{16}\\b"
  },
  {
    "name": "github_token",
    "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"
  },
  {
    "name": "gitlab_token",
    "regex": "\\bglpat-[A-Za-z0-9_\\-]{20,}\\b"
  },
  {
    "name": "google_api_key",
    "regex": "\\bAIza[A-Za-z0-9_\\-]{35}\\b"
  },
  {
    "name": "openai_api_key",
    "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_\\-]{20,}\\b"
  },
  {
    "name": "anthropic_api_key",
    "regex": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}\\b"
  },
  {
    "name": "stripe_api_key",
    "regex": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b"
  },
  {
    "name": "notion_token",
    "regex": "\\bntn_[A-Za-z0-9]{20,}\\b"
  },
  {
    "name": "twilio_api_key",
    "regex": "\\bSK[a-f0-9]{32}\\b"
  },
  {
    "name": "npm_token",
    "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"
  },
  {
    "name": "generic_jwt",
    "regex": "\\beyJ[A-Za-z0-9_\\-]+\\.eyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\b"
  },
  {
    "name": "okta_api_token",
    "regex": "(?i)\\bSSWS[ \\t]+00[A-Za-z0-9_\\-]{40}"
  },
  {
    "name": "atlassian_api_token",
    "regex": "\\bATATT[A-Za-z0-9_\\-=]{20,}"
  },
  {
    "name": "atlassian_scoped_token",
    "regex": "\\bATCTT[A-Za-z0-9_\\-+/=]{20,}"
  },
  {
    "name": "databricks_pat",
    "regex": "\\bdapi[a-f0-9]{32}(?:-[0-9])?"
  },
  {
    "name": "azure_storage_account_key",
    "regex": "(?i)\\bAccountKey[ \\t]*=[ \\t]*[A-Za-z0-9+/]{86}=="
  },
  {
    "name": "azure_entra_client_secret",
    "regex": "\\b[A-Za-z0-9_~.]{3}[0-9]Q~[A-Za-z0-9_~.\\-]{31,34}"
  },
  {
    "name": "elastic_api_key_header",
    "regex": "(?i)\\bApiKey[ \\t]+[A-Za-z0-9+/]{32,}={0,2}"
  },
  {
    "name": "db_connection_uri_password",
    "regex": "(?i)\\b(?:postgres(?:ql)?|redis|rediss|amqps?|mongodb(?:\\+srv)?|clickhouse|mysql):\\/\\/[A-Za-z0-9._~%\\-]{1,128}:[^@/\\s\"]{6,256}@"
  },
  {
    "name": "github_fine_grained_pat",
