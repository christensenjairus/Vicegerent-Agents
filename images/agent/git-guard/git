#!/bin/bash
# PATH-shadowing git wrapper. Two jobs:
#
#   1. Re-assert the trusted hook path at command scope on every call. /etc/gitconfig
#      is SYSTEM scope, which git deliberately ranks below worktree/local/global/XDG
#      config. The chart now owns ~/.gitconfig as a read-only mount (which also wins
#      over XDG), but repo-local and worktree config remain writable by definition, so
#      command scope -- above every file -- is what actually keeps layer 1 alive.
#   2. Reject the push shapes and env/arg overrides a pre-push hook structurally
#      cannot see (--no-verify, hooksPath overrides, GIT_CONFIG_* injection).
#
# Aliases are expanded before classification: git expands a non-shell alias
# internally, so `alias.ship = push --no-verify ...` would otherwise be classified
# as subcommand "ship" and skip every check.
set -uo pipefail

readonly REAL_GIT=/usr/bin/git
readonly TRUSTED_HOOKS=/opt/vicegerent/git-hooks
readonly PROTECTED='main|master|production'
readonly MAX_ALIAS_DEPTH=10

die() {
    echo "vicegerent: $1" >&2
    echo "vicegerent: push a feature branch and open a merge request instead." >&2
    exit 1
}

# Git config keys are case-insensitive; compare lowercased. Values are not touched.
is_hookspath_assignment() {
    local kv="$1" key="${1%%=*}"
    [[ "${kv}" == *=* ]] || key="${kv}"
    [[ "${key,,}" == core.hookspath ]]
}

# GIT_CONFIG_COUNT/KEY/VALUE inject at "command line" precedence, above every
# config file. GIT_CONFIG_NOSYSTEM suppresses /etc/gitconfig; GIT_CONFIG_SYSTEM
# and GIT_CONFIG_GLOBAL repoint it. All of them disarm layer 1, so all are dropped.
# GIT_SSH_COMMAND / GIT_SSL_CAINFO (platform-required) are deliberately preserved.
sanitize_env() {
    local n i
    n="${GIT_CONFIG_COUNT:-0}"
    [[ "${n}" =~ ^[0-9]+$ ]] || n=0
    for ((i = 0; i < n + 64; i++)); do
        unset "GIT_CONFIG_KEY_${i}" "GIT_CONFIG_VALUE_${i}"
    done
    unset GIT_CONFIG_COUNT GIT_CONFIG_NOSYSTEM GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
}

# Splits argv into the pre-subcommand global options (preserved verbatim in
# GLOBAL_OPTS, minus any hooksPath override) and the subcommand plus its args.
# REPO_OPTS additionally collects only the options that change which repository
# git operates on, so branch lookups below run against the same repo git will use.
scan_global_opts() {
    GLOBAL_OPTS=()
    REPO_OPTS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -c)
                is_hookspath_assignment "${2:-}" \
                    && die "BLOCKED: -c core.hooksPath= would disarm the protected-branch hook."
                GLOBAL_OPTS+=("$1" "${2:-}")
                shift 2 || shift
                ;;
            -c*)
                is_hookspath_assignment "${1#-c}" \
                    && die "BLOCKED: -c core.hooksPath= would disarm the protected-branch hook."
                GLOBAL_OPTS+=("$1")
                shift
                ;;
            --config-env)
                is_hookspath_assignment "${2:-}" \
                    && die "BLOCKED: --config-env core.hooksPath= would disarm the protected-branch hook."
                GLOBAL_OPTS+=("$1" "${2:-}")
                shift 2 || shift
                ;;
            --config-env=*)
                is_hookspath_assignment "${1#--config-env=}" \
                    && die "BLOCKED: --config-env core.hooksPath= would disarm the protected-branch hook."
                GLOBAL_OPTS+=("$1")
                shift
                ;;
            -C | --git-dir | --work-tree | --namespace)
                GLOBAL_OPTS+=("$1" "${2:-}")
                REPO_OPTS+=("$1" "${2:-}")
                shift 2 || shift
                ;;
            --git-dir=* | --work-tree=* | --namespace=*)
                GLOBAL_OPTS+=("$1")
                REPO_OPTS+=("$1")
                shift
                ;;
            --exec-path | --super-prefix)
                GLOBAL_OPTS+=("$1" "${2:-}")
                shift 2 || shift
                ;;
            -*)
                GLOBAL_OPTS+=("$1")
                shift
                ;;
            *)
                SUBCMD="$1"
                shift
                SUBARGS=("$@")
                return 0
                ;;
        esac
    done
    SUBCMD=''
    SUBARGS=()
}

# git expands a non-shell alias in-process, so the real subcommand must be known
# before classification. A shell alias (leading '!') can invoke git any way it
# likes and cannot be analysed, so it is refused outright.
resolve_alias() {
    local depth=0 expansion
    while [ -n "${SUBCMD}" ] && [ "${depth}" -lt "${MAX_ALIAS_DEPTH}" ]; do
        expansion="$("${REAL_GIT}" "${REPO_OPTS[@]}" config --get "alias.${SUBCMD}" 2>/dev/null)" || return 0
        [ -n "${expansion}" ] || return 0
        [[ "${expansion}" == '!'* ]] \
            && die "BLOCKED: shell alias '${SUBCMD}' cannot be checked; invoke git directly."
        # Word-split the expansion the way git does for a non-shell alias.
        local words=()
        read -r -a words <<< "${expansion}"
        [ "${#words[@]}" -gt 0 ] || return 0
        set -- "${words[@]}" "${SUBARGS[@]}"
        local saved_global=("${GLOBAL_OPTS[@]}")
        scan_global_opts "$@"
        GLOBAL_OPTS=("${saved_global[@]}" "${GLOBAL_OPTS[@]}")
        depth=$((depth + 1))
    done
}

# True when the push names a protected destination. Config-supplied destinations
# (remote.<name>.push, push.default, mirror) never appear in argv, so this is a
# best-effort early check -- the hook is what catches those, which is why the
# trusted hooksPath injection below is the load-bearing half.
push_targets_protected() {
    local arg dst delete=0 had_refspec=0 pos=() skip_value=0
    for arg in "$@"; do
        if [ "${skip_value}" -eq 1 ]; then
            skip_value=0
            continue
        fi
        case "${arg}" in
            --mirror | --all) return 0 ;;
            -d | --delete) delete=1 ;;
            -o | --push-option | --receive-pack | --exec | --repo | --force-with-lease)
                skip_value=1 ;;
            -*) ;;
            *) pos+=("${arg}") ;;
        esac
    done

    local i
    for ((i = 1; i < ${#pos[@]}; i++)); do
        had_refspec=1
        dst="${pos[i]#+}"
        [[ "${dst}" == *:* ]] && dst="${dst##*:}"
        dst="${dst#refs/heads/}"
        [[ "${dst}" =~ ^(${PROTECTED})$ ]] && return 0
    done
    [ "${delete}" -eq 1 ] && [ "${had_refspec}" -eq 1 ] && return 1

    if [ "${had_refspec}" -eq 0 ]; then
        local cur
        cur="$("${REAL_GIT}" "${REPO_OPTS[@]}" symbolic-ref --short -q HEAD 2>/dev/null || true)"
        [[ "${cur}" =~ ^(${PROTECTED})$ ]] && return 0
    fi
    return 1
}

sanitize_env
SUBCMD=''
SUBARGS=()
GLOBAL_OPTS=()
REPO_OPTS=()
scan_global_opts "$@"
resolve_alias

# Repo-local and worktree config still outrank /etc/gitconfig, so a persisted hooksPath
# write is refused here too. (~/.gitconfig is a read-only mount, which denies the global
# case at the kernel; this covers the scopes a mount cannot.) Reads pass.
if [ "${SUBCMD}" = "config" ]; then
    for arg in "${SUBARGS[@]}"; do
        if is_hookspath_assignment "${arg}"; then
            for a in "${SUBARGS[@]}"; do
                case "${a}" in
                    --get* | --list | -l | --show-origin | --show-scope)
                        exec "${REAL_GIT}" "${GLOBAL_OPTS[@]}" "${SUBCMD}" "${SUBARGS[@]}" ;;
                esac
            done
            die "BLOCKED: writing core.hooksPath would disarm the protected-branch hook."
        fi
    done
fi

if [ "${SUBCMD}" = "push" ]; then
    for arg in "${SUBARGS[@]}"; do
        [ "${arg}" = "--no-verify" ] \
            && die "BLOCKED: git push --no-verify bypasses the protected-branch hook."
    done
    if push_targets_protected "${SUBARGS[@]}"; then
        die "BLOCKED: push to a protected branch (${PROTECTED//|/, })."
    fi
fi

# Injected last so it wins over any -c the caller passed, and at command scope so
# it wins over every config file including the agent-writable ones.
if [ -n "${SUBCMD}" ]; then
    exec "${REAL_GIT}" "${GLOBAL_OPTS[@]}" -c "core.hooksPath=${TRUSTED_HOOKS}" \
        "${SUBCMD}" "${SUBARGS[@]}"
fi
exec "${REAL_GIT}" "$@"
