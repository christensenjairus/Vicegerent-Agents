#!/usr/bin/env bash
# scripts/host/setup-host-mcp
#
# Idempotent setup of the host-side prerequisites for the vicegerent host stack
# (ToolHive workloads + vMCP + ghostunnel + rclone, kept awake by caffeinate):
#
#   1. Homebrew packages: thv (ToolHive), ghostunnel, supervisor, rclone, terminal-notifier
#   2. Python venv + deps: pip install -r host/mcp/requirements-host.txt
#   3. ToolHive secrets provider + required API-key secrets (guidance)
#   4. Configure MCP servers: enable/skip each + set its secrets
#   5. Final doctor check: vicegerent mcp doctor
#   6. Link the CLI: symlink ~/.local/bin/vicegerent → this repo's ./vicegerent
#
# Flags:
#   -y, --yes      auto-approve prerequisite installs (configure stays interactive)
#   -h, --help     show this help
#
# Prerequisites on the host Mac: Homebrew, a running kind cluster (for the
# kubernetes MCP server) — see `./vicegerent setup cluster`.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

ASSUME_YES=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)    ASSUME_YES=1 ;;
    -h|--help)   sed -n '2,19p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# shellcheck source=../lib/cli-ui.sh
source "$REPO_ROOT/scripts/lib/cli-ui.sh"

info()    { ui_success "$@"; }
step()    { ui_section "$@"; }
warn()    { ui_warn "$@"; }
die()     { ui_error "$@"; exit 1; }

confirm() {
  if [[ "$ASSUME_YES" == "1" ]]; then return 0; fi
  local ans
  read -r -p "  Proceed? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required but not found — install Homebrew first"
}

# ---------------------------------------------------------------------------
# 0. Sanity
# ---------------------------------------------------------------------------
need_cmd brew
need_cmd python3

# ---------------------------------------------------------------------------
# 1. Homebrew packages
# ---------------------------------------------------------------------------
step "Homebrew packages"

# ToolHive ships from the stacklok tap; ghostunnel + supervisor are core formulae.
# `bin:formula` pairs — plain indexed array so this works on macOS's stock bash 3.2
# (which has no associative arrays; `declare -A [thv]=…` there dies under `set -u`).
BREW_FORMULAE=(
  "thv:stacklok/tap/thv"
  "ghostunnel:ghostunnel"
  "supervisor:supervisor"
  "rclone:rclone"
  "terminal-notifier:terminal-notifier"
)
MISSING=()
for entry in "${BREW_FORMULAE[@]}"; do
  formula="${entry#*:}"
  if brew list --formula "$formula" >/dev/null 2>&1; then
    info "$formula already installed"
  else
    MISSING+=("$formula")
  fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
  echo "  Will install: ${MISSING[*]}"
  if confirm; then
    brew install "${MISSING[@]}"
    info "Installed: ${MISSING[*]}"
  else
    warn "Skipped Homebrew install. Install manually, e.g.:"
    warn "    brew install ${MISSING[*]}"
  fi
fi

command -v thv >/dev/null 2>&1 || warn "thv still not on PATH — see https://github.com/stacklok/toolhive"

# ---------------------------------------------------------------------------
# 2. Python deps
# ---------------------------------------------------------------------------
step "Python venv + dependencies"

REQ="$REPO_ROOT/host/mcp/requirements-host.txt"
VENV="$REPO_ROOT/host/mcp/.venv"
[[ -f "$REQ" ]] || die "requirements-host.txt not found: $REQ"

if [[ ! -d "$VENV" ]]; then
  echo "  Creating venv at host/mcp/.venv"
  python3 -m venv "$VENV"
fi

if "$VENV/bin/python" -c "
import importlib.util, sys
mods = ['rich', 'supervisor', 'textual']
missing = [m for m in mods if importlib.util.find_spec(m) is None]
if missing:
    print('missing:', ' '.join(missing))
    sys.exit(1)
" 2>/dev/null; then
  info "Python dependencies up to date (host/mcp/.venv)"
else
  echo "  Installing from $REQ into host/mcp/.venv"
  confirm || die "Aborted."
  "$VENV/bin/pip" install -r "$REQ" -q
  info "Python dependencies installed into host/mcp/.venv"
fi

# ---------------------------------------------------------------------------
# 3. ToolHive secrets provider + required secrets
# ---------------------------------------------------------------------------
step "ToolHive secrets"

if command -v thv >/dev/null 2>&1 && thv secret list >/dev/null 2>&1; then
  info "thv secrets provider configured"
else
  warn "No ToolHive secrets provider is configured; OAuth tokens and API keys cannot persist yet."
  ui_command "thv secret setup" "Choose the encrypted provider"
fi

# ---------------------------------------------------------------------------
# 4. Configure MCP servers (enable/skip each + set its secrets)
# ---------------------------------------------------------------------------
step "Configure MCP servers"
if [[ "$ASSUME_YES" == "1" ]]; then
  echo
  echo "  Skipping interactive server configuration (-y/non-interactive run)."
  echo "  Re-run './vicegerent setup mcp' without -y to enable servers and set keys."
else
  echo
  ui_info "MCP servers are off by default. Choose which ones to enable and configure their authentication."
  ui_info "API keys use hidden prompts; OAuth servers open a browser on first start."
  ui_info "Re-run 'vicegerent setup mcp' whenever you want to change the selection."
  echo
  "$REPO_ROOT/host/mcp/.venv/bin/python" "$REPO_ROOT/host/mcp/vicegerent_mcp.py" configure
fi

# ---------------------------------------------------------------------------
# 5. Doctor check
# ---------------------------------------------------------------------------
step "Doctor check"
echo
# Reported, not fatal: the remaining steps (CLI symlink, next-steps) are still
# worth doing on a partial setup, and doctor's own output names what is missing.
"$REPO_ROOT/host/mcp/.venv/bin/python" "$REPO_ROOT/host/mcp/vicegerent_mcp.py" doctor \
  || warn "doctor reported missing prerequisites (above); fix them, then re-run './vicegerent mcp doctor'."

# ---------------------------------------------------------------------------
# 6. Link the vicegerent CLI onto PATH (~/.local/bin)
# ---------------------------------------------------------------------------
step "CLI symlink (~/.local/bin/vicegerent)"

LINK_DIR="$HOME/.local/bin"
LINK="$LINK_DIR/vicegerent"
TARGET="$REPO_ROOT/vicegerent"
if [[ -L "$LINK" && "$(readlink "$LINK")" == "$TARGET" ]]; then
  info "vicegerent already linked → $TARGET"
elif [[ -e "$LINK" && ! -L "$LINK" ]]; then
  warn "$LINK exists and is not a symlink; leaving it untouched."
else
  echo "  Will link $LINK → $TARGET"
  if confirm; then
    mkdir -p "$LINK_DIR"
    ln -sf "$TARGET" "$LINK"
    info "Linked vicegerent → $TARGET (run 'vicegerent' from any directory)"
    case ":$PATH:" in
      *":$LINK_DIR:"*) ;;
      *) warn "$LINK_DIR is not on your PATH — add it: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac
  else
    warn "Skipped CLI symlink. Invoke it as ./vicegerent from the repo root."
  fi
fi

echo
ui_header "Host stack setup complete"
echo
ui_section "Next steps"
ui_command "./vicegerent setup cluster" "Create the Kind cluster"
ui_command "./vicegerent setup secrets platform" "Provision host and cluster secrets"
ui_command "./vicegerent install" "Install the platform"
ui_command "./vicegerent start" "Bring up the host stack"
